{
  "name": "api",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "check-types": "tsc --noEmit",
     "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "auth:generate": "pnpm dlx auth@latest generate --config src/lib/auth.ts --output src/db/auth-schema.ts"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.18",
    "@hono/node-server": "^2.1.3",
    "@neondatabase/serverless": "^1.2.0",
    "better-auth": "^1.7.18",
    "dotenv": "^18.0.10",
    "drizzle-orm": "1.0.0-rc.5",
    "hono": "^4.13.13",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^26.1.1",
    "drizzle-kit": "1.0.0-rc.5",
    "tsx": "^4.23.0",
    "typescript": "^7.0.2"
  }
}