{
  "name": "@repo/api",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "check-types": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "auth:generate": "pnpm dlx auth@latest generate --config src/auth/auth.ts --output src/db/schemas/auth.ts",
    "dev:trigger": "pnpm dlx trigger.dev@latest dev"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1170.0",
    "@aws-sdk/s3-request-presigner": "^3.1170.0",
    "@better-auth/drizzle-adapter": "^1.7.18",
    "@hono/node-server": "^2.1.3",
    "@langchain/community": "^1.1.29",
    "@langchain/core": "^1.4.1",
    "@langchain/openai": "^1.8.4",
    "@langchain/textsplitters": "^1.0.2",
    "@neondatabase/serverless": "^1.2.0",
    "@trigger.dev/sdk": "4.8.5",
    "better-auth": "^1.7.18",
    "csv-parse": "^7.0.3",
    "dotenv": "^18.0.10",
    "drizzle-orm": "1.0.0-rc.5",
    "hono": "^4.13.13",
    "mammoth": "^1.13.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.23.1",
    "resend": "^6.38.1",
    "word-extractor": "^1.0.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@trigger.dev/build": "4.8.5",
    "@trigger.dev/cli": "4.8.5",
    "@types/node": "^26.1.1",
    "drizzle-kit": "1.0.0-rc.5",
    "tsx": "^4.23.0",
    "typescript": "~5.9.3"
  }
}